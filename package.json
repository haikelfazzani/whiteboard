{
  "name": "whiteboard-react",
  "version": "2.1.0",
  "description": "React 19 whiteboard component with shapes, connectors, and WebM recording",
  "main": "lib/index.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "files": [
    "/lib"
  ],
  "homepage": "https://haikelfazzani.github.io/whiteboard",
  "repository": "https://github.com/haikelfazzani/whiteboard",
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "deploy": "npm run build:demo && gh-pages -d demo-dist -b gh-pages --dotfiles"
  },
  "author": "Haikel Fazzani",
  "license": "MIT",
  "peerDependencies": {
    "fabric": ">=5.3.0 <6",
    "react": "^19.0.0",
    "react-colorful": ">=5.6.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/fabric": "^5.3.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fabric": "^5.3.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "react": "^19.3.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.3.0",
    "rollup": "^4.30.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "np": {
    "publish": false,
    "tests": false
  },
  "keywords": [
    "whiteboard",
    "sketchboard",
    "component",
    "react",
    "fabric",
    "video-export"
  ]
